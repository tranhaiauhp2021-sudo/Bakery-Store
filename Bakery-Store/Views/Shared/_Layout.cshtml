<!DOCTYPE html>
<html>


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
<style>
    .pink-logo {
        color: #e7809b !important;
        font-size: 25px;
        font-weight: bold;
        letter-spacing: 1px;
        text-decoration: none;
    }

    .pink-logo:hover {
        color: #c95a79 !important;
    }
</style>

</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink("🎀 PINK BAKERY", "Index", "Home", new { area = "" }, new { @class = "navbar-brand pink-logo" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">


                    <li class="nav-item">
                        @Html.ActionLink("Trang chủ", "Index", "Home",
                            new { area = "" },
                            new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#products">
                            Sản phẩm
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#bakery-cart">
                            Giỏ hàng 🛒
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#pink-account">
                            👤 Tài khoản
                        </a>
                    </li>


                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />

        <footer>
            <p>&copy; @DateTime.Now.Year - PINK BAKERY | Baked with Love ♡</p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
